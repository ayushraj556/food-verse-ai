# Google Gemini API Key
# Leave empty to run in Demo Mode with high-fidelity sample responses
GEMINI_API_KEY=

# Gemini Vision & Multimodal Model
# Recommended: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Security & CORS (Comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database & Storage
DATABASE_URL=sqlite:///./food_verse.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
REQUEST_TIMEOUT_SECONDS=30
